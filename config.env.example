# Copier vers config.env (exclu de Git). Fichier BASH de confiance : source config.env
# Pas un fichier docker --env-file : il contient des variables shell dérivées.
# Aucune clé privée ici. Ne jamais ajouter de jeton Google/Docker ou de session.
PROJECT_ID='remplacer-par-ton-projet-google'

# us-central1 = États-Unis, choisi pour les franchises gratuites de stockage.
# europe-west1 = Belgique ; choisir AVANT de créer les buckets et vérifier les coûts.
REGION='us-central1'
IMAGE='docker.io/drdpham/whatsapp-webjs:latest'

# À remplir après création du tableur (installation, étape 3).
SPREADSHEET_ID=''
# À remplir après la commande locale group-id (installation, étape 4).
GROUP_ID=''
DRY_RUN='true'

# Publication à 09 h Paris pour demain ; préparer le client 3 minutes avant.
# Le code refuse les envois à partir de 09 h 15, sans rattrapage.
TIME_ZONE='Europe/Paris'
SCHEDULE='57 8 * * *'
# Seule la valeur 1 est supportée : ne pas conserver un ancien réglage à 2.
LEAD_DAYS='1'

# Noms des ressources Google ; garder ces valeurs pour suivre le guide.
JOB='whatsapp-polls-daily'
CODE_BUCKET="${PROJECT_ID}-wa-code"
STATE_BUCKET="${PROJECT_ID}-wa-state"
RUNTIME="wa-runtime@${PROJECT_ID}.iam.gserviceaccount.com"
READER="wa-reader@${PROJECT_ID}.iam.gserviceaccount.com"
SCHEDULER="wa-scheduler@${PROJECT_ID}.iam.gserviceaccount.com"
